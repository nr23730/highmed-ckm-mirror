definition
	OBSERVATION[at0000] matches {    -- Speech intelligibility test
		data matches {
			HISTORY[at0001] matches {    -- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									CLUSTER[at0233] occurrences matches {0..*} matches {    -- Measurement of test list
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0234] matches {    -- Measurement identifier
												value matches {
													DV_IDENTIFIER matches {*}
												}
											}
											ELEMENT[at0235] occurrences matches {0..1} matches {    -- Test list name
												value matches {
													DV_TEXT matches {*}
												}
											}
											ELEMENT[at0236] occurrences matches {0..1} matches {    -- Speech level at start
												value matches {
													DV_QUANTITY matches {*}
												}
											}
											ELEMENT[at0237] occurrences matches {0..1} matches {    -- SNR at start
												value matches {
													C_DV_QUANTITY <
														property = <[openehr::123]>
														list = <
															["1"] = <
																units = <"dB[SPL]{SNR}">
																magnitude = <|-50.0..200.0|>
																precision = <|2|>
															>
														>
													>
												}
											}
											ELEMENT[at0238] occurrences matches {0..1} matches {    -- Speech intelligibility
												value matches {
													DV_PROPORTION matches {
														numerator matches {|0.0..100.0|}
														type matches {2}
													}
												}
											}
											allow_archetype CLUSTER[at0287] occurrences matches {0..1} matches {    -- No test result
												include
													archetype_id/value matches {/openEHR-EHR-CLUSTER\.exclusion_exam\.v1/}
											}
											CLUSTER[at0239] occurrences matches {0..*} matches {    -- Measurement of test list item
												items cardinality matches {1..*; unordered} matches {
													ELEMENT[at0242] occurrences matches {0..1} matches {    -- Test list item name
														value matches {
															DV_TEXT matches {*}
														}
													}
													ELEMENT[at0243] matches {    -- Speech level
														value matches {
															DV_QUANTITY matches {*}
														}
													}
													ELEMENT[at0244] occurrences matches {0..1} matches {    -- SNR
														value matches {
															C_DV_QUANTITY <
																property = <[openehr::123]>
																list = <
																	["1"] = <
																		units = <"dB[SPL]{SNR}">
																		magnitude = <|-50.0..200.0|>
																		precision = <|2|>
																	>
																>
															>
														}
													}
													ELEMENT[at0245] matches {    -- Speech intelligibility
														value matches {
															DV_PROPORTION matches {
																numerator matches {|0.0..100.0|}
																type matches {2}
															}
														}
													}
												}
											}
											CLUSTER[at0241] occurrences matches {0..1} matches {    -- Speech recognition threshold adaptive
												items cardinality matches {1..*; unordered} matches {
													ELEMENT[at0246] matches {    -- Target speech intelligibility
														value matches {
															DV_PROPORTION matches {
																numerator matches {|0.0..100.0|; 50.0}
																type matches {2}
															}
														}
													}
													ELEMENT[at0247] matches {    -- Speech level at target
														value matches {
															DV_QUANTITY matches {*}
														}
													}
													ELEMENT[at0248] occurrences matches {0..1} matches {    -- SNR at target
														value matches {
															C_DV_QUANTITY <
																property = <[openehr::123]>
																list = <
																	["1"] = <
																		units = <"dB[SPL]{SNR}">
																		magnitude = <|-50.0..200.0|>
																		precision = <|2|>
																	>
																>
															>
														}
													}
													ELEMENT[at0276] occurrences matches {0..1} matches {    -- Slope at target
														value matches {
															DV_QUANTITY matches {*}
														}
													}
												}
											}
										}
									}
									CLUSTER[at0293] occurrences matches {0..1} matches {    -- Derived results
										items cardinality matches {1..*; unordered} matches {
											CLUSTER[at0017] occurrences matches {0..*} matches {    -- Speech recognition threshold
												items cardinality matches {1..*; unordered} matches {
													ELEMENT[at0194] matches {    -- Target speech intelligibility
														value matches {
															DV_PROPORTION matches {
																numerator matches {|0.0..100.0|; 50.0}
																type matches {2}
															}
														}
													}
													ELEMENT[at0250] matches {    -- Speech level at target
														value matches {
															DV_QUANTITY matches {*}
														}
													}
													ELEMENT[at0301] occurrences matches {0..1} matches {    -- SNR at target
														value matches {
															C_DV_QUANTITY <
																property = <[openehr::123]>
																list = <
																	["1"] = <
																		units = <"dB[SPL]{SNR}">
																		magnitude = <|-50.0..200.0|>
																		precision = <|2|>
																	>
																>
															>
														}
													}
													ELEMENT[at0277] occurrences matches {0..1} matches {    -- Slope at target
														value matches {
															DV_QUANTITY matches {*}
														}
													}
													ELEMENT[at0201] occurrences matches {0..1} matches {    -- SRT calculation method
														value matches {
															DV_TEXT matches {*}
														}
													}
													ELEMENT[at0203] occurrences matches {0..*} matches {    -- Related measurements
														value matches {
															DV_IDENTIFIER matches {*}
														}
													}
												}
											}
											CLUSTER[at0296] occurrences matches {0..1} matches {    -- Maximum discrimination score
												items cardinality matches {1..*; unordered} matches {
													ELEMENT[at0298] occurrences matches {0..1} matches {    -- Maximum intelligibility
														value matches {
															DV_PROPORTION matches {
																type matches {2,3}
															}
														}
													}
													ELEMENT[at0299] occurrences matches {0..1} matches {    -- Speech level at maximum intelligibility
														value matches {
															DV_QUANTITY matches {*}
														}
													}
													ELEMENT[at0300] occurrences matches {0..1} matches {    -- SNR at maximum intelligibility
														value matches {
															C_DV_QUANTITY <
																
																list = <
																	["1"] = <
																		units = <"dB[SPL]{SNR}">
																		magnitude = <|-50.0..200.0|>
																		precision = <|2|>
																	>
																>
															>
														}
													}
													ELEMENT[at0297] occurrences matches {0..*} matches {    -- Related measurements
														value matches {
															DV_IDENTIFIER matches {*}
														}
													}
												}
											}
											CLUSTER[at0324] occurrences matches {0..1} matches {    -- Mean speech intelligibility
												items cardinality matches {1..*; unordered} matches {
													ELEMENT[at0325] matches {    -- Speech intelligibility
														value matches {
															DV_PROPORTION matches {
																type matches {2}
															}
														}
													}
													ELEMENT[at0330] occurrences matches {0..*} matches {    -- Related measurements
														value matches {
															DV_IDENTIFIER matches {*}
														}
													}
												}
											}
											CLUSTER[at0332] occurrences matches {0..1} matches {    -- Sum speech intelligibility
												items cardinality matches {1..*; unordered} matches {
													ELEMENT[at0333] matches {    -- Speech intelligibility
														value matches {
															DV_COUNT matches {
																magnitude matches {|0..500|}
															}
														}
													}
													ELEMENT[at0334] occurrences matches {0..*} matches {    -- Related measurements
														value matches {
															DV_IDENTIFIER matches {*}
														}
													}
												}
											}
										}
									}
									ELEMENT[at0022] occurrences matches {0..1} matches {    -- Overall comment
										value matches {
											DV_TEXT matches {*}
										}
									}
									allow_archetype CLUSTER[at0163] occurrences matches {0..1} matches {    -- No test result
										include
											archetype_id/value matches {/openEHR-EHR-CLUSTER\.exclusion_exam\.v1/}
									}
									ELEMENT[at0200] matches {    -- Training condition
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
								}
							}
						}
						state matches {
							ITEM_TREE[at0023] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									CLUSTER[at0164] occurrences matches {0..1} matches {    -- Hearing device during test
										items cardinality matches {1..*; unordered} matches {
											allow_archetype CLUSTER[at0165] matches {    -- Hearing device
												include
													archetype_id/value matches {/openEHR-EHR-CLUSTER\.device\.v1/}
											}
											ELEMENT[at0166] matches {    -- Side of hearing device
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0167,    -- Left
															at0168]    -- Right
														}
													}
												}
											}
											ELEMENT[at0169] occurrences matches {0..1} matches {    -- Comment
												value matches {
													DV_TEXT matches {*}
												}
											}
										}
									}
									ELEMENT[at0170] occurrences matches {0..1} matches {    -- Confounding factors
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0153] occurrences matches {0..1} matches {    -- Language proficiency
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0154,    -- Native
													at0155,    -- Fluent
													at0156,    -- Basic
													at0157]    -- None
												}
											}
											DV_TEXT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0032] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0145] occurrences matches {0..1} matches {    -- Test name
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0251] occurrences matches {0..1} matches {    -- Test language
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0335] occurrences matches {0..1} matches {    -- Test material details
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0054] occurrences matches {0..1} matches {    -- Voice type
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0055,    -- Female
									at0056,    -- Male
									at0204,    -- Synthetic female
									at0205,    -- Synthetic male
									at0208,    -- Child
									at0209]    -- Synthetic child
								}
							}
						}
					}
					ELEMENT[at0101] occurrences matches {0..1} matches {    -- Announcement
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0102,    -- Sentence
									at0103,    -- Non-speech auditory cue
									at0104,    -- Visual cue
									at0105]    -- Without
								}
							}
						}
					}
					ELEMENT[at0257] matches {    -- Test in background noise
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0285,    -- Quiet
									at0286]    -- Noise
								}
							}
						}
					}
					ELEMENT[at0196] occurrences matches {0..1} matches {    -- Fixed stimulus
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0336,    -- Speech
									at0337,    -- Noise
									at0338]    -- Overall
								}
							}
						}
					}
					ELEMENT[at0302] matches {    -- Speech level unit
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0197,    -- dB ref
									at0198,    -- dB SPL
									at0292,    -- dB HL
									at0306]    -- dB US
								}
							}
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0132] matches {    -- Tested side
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0134,    -- Right ear
									at0133,    -- Left ear
									at0135]    -- Binaural
								}
							}
						}
					}
					CLUSTER[at0107] occurrences matches {0..1} matches {    -- Adaptive procedure
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0227] matches {    -- Level control
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0228,    -- One-up one-down
											at0229]    -- Brand & Kollmeier (2002)
										}
									}
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0231] occurrences matches {0..1} matches {    -- Level control details
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0090] occurrences matches {0..1} matches {    -- Step size at start
								value matches {
									C_DV_QUANTITY <
										property = <[openehr::123]>
										list = <
											["1"] = <
												units = <"dB">
												precision = <|0|>
											>
										>
									>
								}
							}
							ELEMENT[at0288] occurrences matches {0..1} matches {    -- Fit procedure
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0289,    -- Averaging of last N levels
											at0290]    -- Brand & Kollmeier (2002)
										}
									}
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0291] occurrences matches {0..1} matches {    -- Fit procedure details
								value matches {
									DV_TEXT matches {*}
								}
							}
						}
					}
					CLUSTER[at0219] matches {    -- Speech stimulus
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0070] matches {    -- Type
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0071,    -- Nonsense syllable
											at0072,    -- Nonsense CVC
											at0073,    -- Nonsense word
											at0074,    -- Monosyllabic word
											at0075,    -- Spondee word
											at0076,    -- Trochee word
											at0137,    -- Matrix sentence
											at0138,    -- Meaningful sentence
											at0099,    -- Number
											at0100,    -- Digit triplet
											at0179]    -- Phoneme
										}
									}
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0225] occurrences matches {0..1} matches {    -- Azimuth
								value matches {
									C_DV_QUANTITY <
										property = <[openehr::497]>
										list = <
											["1"] = <
												units = <"deg">
												magnitude = <|0.0..360.0|>
											>
										>
									>
								}
							}
							ELEMENT[at0226] occurrences matches {0..1} matches {    -- Elevation
								value matches {
									C_DV_QUANTITY <
										property = <[openehr::497]>
										list = <
											["1"] = <
												units = <"deg">
												magnitude = <|0.0..360.0|>
											>
										>

										assumed_value = <
											units = <"deg">
											magnitude = <0.0>
											precision = <-1>
										>
									>
								}
							}
							ELEMENT[at0339] occurrences matches {0..1} matches {    -- Distance of the loudspeaker
								value matches {
									C_DV_QUANTITY <
										property = <[openehr::122]>
										list = <
											["1"] = <
												units = <"m">
											>
										>
									>
								}
							}
							ELEMENT[at0312] occurrences matches {0..1} matches {    -- Directionality characteristics
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0313,    -- Diotic
											at0314,    -- Dichotic
											at0315,    -- Virtual acoustics
											at0341]    -- Antiphasic
										}
									}
								}
							}
						}
					}
					CLUSTER[at0216] occurrences matches {0..*} matches {    -- Noise stimulus
						items cardinality matches {1..*; unordered} matches {
							CLUSTER[at0374] occurrences matches {0..1} matches {    -- Properties
								items cardinality matches {1..*; unordered} matches {
									ELEMENT[at0040] matches {    -- Type
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0381,    -- ISTS
													at0382,    -- IFNoise
													at0383,    -- ICRA-1
													at0384,    -- ICRA-4
													at0385,    -- ICRA-5
													at0386,    -- CCITT
													at0371,    -- Speech-shaped noise (test-specific)
													at0372,    -- Speech-shaped noise (general)
													at0043,    -- Multitalker babble noise
													at0378,    -- Babble noise
													at0044,    -- Interfering speaker
													at0041,    -- White noise
													at0379]    -- Pink noise
												}
											}
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0375] occurrences matches {0..1} matches {    -- Temporal characteristics
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0376,    -- Stationary
													at0377]    -- Fluctuating
												}
											}
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0380] occurrences matches {0..1} matches {    -- Spectral characteristics
										value matches {
											DV_TEXT matches {*}
										}
									}
								}
							}
							ELEMENT[at0217] occurrences matches {0..1} matches {    -- Azimuth
								value matches {
									C_DV_QUANTITY <
										property = <[openehr::497]>
										list = <
											["1"] = <
												units = <"deg">
												magnitude = <|0.0..360.0|>
											>
										>
									>
								}
							}
							ELEMENT[at0218] occurrences matches {0..1} matches {    -- Elevation
								value matches {
									C_DV_QUANTITY <
										property = <[openehr::497]>
										list = <
											["1"] = <
												units = <"deg">
												magnitude = <|0.0..360.0|>
											>
										>

										assumed_value = <
											units = <"deg">
											magnitude = <0.0>
											precision = <-1>
										>
									>
								}
							}
							ELEMENT[at0340] occurrences matches {0..1} matches {    -- Distance of the loudspeaker
								value matches {
									C_DV_QUANTITY <
										property = <[openehr::122]>
										list = <
											["1"] = <
												units = <"m">
											>
										>
									>
								}
							}
							ELEMENT[at0140] occurrences matches {0..1} matches {    -- Stimulus details
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0316] occurrences matches {0..1} matches {    -- Directionality characteristics
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0317,    -- Diotic
											at0318,    -- Dichotic
											at0319,    -- Virtual acoustics
											at0342]    -- Antiphasic
										}
									}
								}
							}
						}
					}
					CLUSTER[at0258] occurrences matches {0..1} matches {    -- Masking
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0271] occurrences matches {0..1} matches {    -- Type
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0272,    -- White noise
											at0387,    -- Speech-shaped noise
											at0345,    -- Blocked ear
											at0346,    -- Manual masking with patient's finger
											at0388]    -- Pink noise
										}
									}
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0279] occurrences matches {0..1} matches {    -- Presentation method
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0281,    -- Insert earphone
											at0282,    -- Headphone
											at0283]    -- Direct streaming to sound processor
										}
									}
									DV_TEXT matches {*}
								}
							}
							allow_archetype CLUSTER[at0270] occurrences matches {0..1} matches {    -- Presentation method details
								include
									archetype_id/value matches {/openEHR-EHR-CLUSTER\.device\.v1/}
							}
						}
					}
					ELEMENT[at0181] occurrences matches {0..1} matches {    -- Test environment
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0182,    -- Sound treated room
									at0183,    -- Non-sound treated room
									at0184,    -- Freefield
									at0347]    -- Remote testing
								}
							}
							DV_TEXT matches {*}
						}
					}
					allow_archetype CLUSTER[at0185] occurrences matches {0..1} matches {    -- Test environment details
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.device\.v1/}
					}
					ELEMENT[at0172] matches {    -- Presentation method
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0173,    -- Loudspeaker
									at0174,    -- Insert earphone
									at0175,    -- Headphone
									at0176,    -- Direct streaming to sound processor
									at0177,    -- Live voice
									at0348,    -- Telephone
									at0357]    -- Unknown
								}
							}
							DV_TEXT matches {*}
						}
					}
					allow_archetype CLUSTER[at0178] occurrences matches {0..1} matches {    -- Presentation method details
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.device\.v1/}
					}
					ELEMENT[at0307] occurrences matches {0..1} matches {    -- Freefield equalization
						value matches {
							DV_BOOLEAN matches {*}
						}
					}
					ELEMENT[at0093] matches {    -- Presented sensory modalities
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0094,    -- Auditory test
									at0095,    -- Audiovisual test
									at0096]    -- Visual test
								}
							}
						}
					}
					ELEMENT[at0064] occurrences matches {0..1} matches {    -- Response set
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0065,    -- Open set
									at0066;    -- Closed set
									at0065]
								}
							}
						}
					}
					ELEMENT[at0060] occurrences matches {0..1} matches {    -- Response mode
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0171,    -- Computer
									at0061,    -- Vocal
									at0062,    -- Picture pointing
									at0063,    -- Written response alternatives
									at0086,    -- Concrete object pointing
									at0358]    -- ASR
								}
							}
						}
					}
					ELEMENT[at0113] occurrences matches {0..1} matches {    -- Scoring method
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0114,    -- Word scoring
									at0115,    -- Sentence scoring
									at0116,    -- Phoneme scoring
									at0117]    -- Keyword scoring
								}
							}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Speech intelligibility test">
					description = <"A record of results from an audiological speech intelligibility test conducted to assess speech recognition, speech discrimination, or speech intelligibility. Note that 'Speech intelligibility' is used throughout the archetype for consistency reasons.  ">
				>
				["at0001"] = <
					text = <"Event Series">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0017"] = <
					text = <"Speech recognition threshold">
					description = <"The estimated speech recognition threshold (SRT) derived from several 'Measurements of test lists'. For example: calculating an SRT from multiple intelligibilities at different levels. ">
					comment = <"Note: SRTs derived from test lists are usually documented in 'Protocol' > 'Adaptive procedure' > 'Fit procedure'.">
				>
				["at0022"] = <
					text = <"Overall comment">
					description = <"Additional narrative about the speech intelligibility measurement not captured in other fields.">
				>
				["at0023"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0032"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0040"] = <
					text = <"Type">
					description = <"The type of noise stimulus used during speech in noise testing. Further details can be given in 'Noise type details'. ">
					comment = <"Not applicable for speech in quiet tests. ">
				>
				["at0041"] = <
					text = <"White noise">
					description = <"Noise that has the same power at all frequencies (i.e., a flat power spectrum).">
				>
				["at0043"] = <
					text = <"Multitalker babble noise">
					description = <"A recording of the voices of many people who are talking simultaneously, resulting in an unintelligible babble.">
				>
				["at0044"] = <
					text = <"Interfering speaker">
					description = <"The masker is a single person speaking other than the speaker of the test stimulus.">
				>
				["at0054"] = <
					text = <"Voice type">
					description = <"The voice type (sex) of the speech stimulus.">
				>
				["at0055"] = <
					text = <"Female">
					description = <"Stimuli presented by a female talker.">
				>
				["at0056"] = <
					text = <"Male">
					description = <"Stimuli presented by a male talker.">
				>
				["at0060"] = <
					text = <"Response mode">
					description = <"The mode how the listener provides the responses.">
				>
				["at0061"] = <
					text = <"Vocal">
					description = <"The response is given verbally by the listener to the examiner.">
				>
				["at0062"] = <
					text = <"Picture pointing">
					description = <"The response is given by pointing to a picture of the stimulus item.">
				>
				["at0063"] = <
					text = <"Written response alternatives">
					description = <"The response is given by pointing to written text corresponding to the stimulus item.">
				>
				["at0064"] = <
					text = <"Response set">
					description = <"The type of the response set.">
				>
				["at0065"] = <
					text = <"Open set">
					description = <"The response set is unlimited.">
				>
				["at0066"] = <
					text = <"Closed set">
					description = <"The response set is limited.">
				>
				["at0070"] = <
					text = <"Type">
					description = <"The type of speech stimulus used.">
				>
				["at0071"] = <
					text = <"Nonsense syllable">
					description = <"A consonant-vowel (CV) or CCV or VC or VCC item that is not a real word but is phonotactically correct.">
				>
				["at0072"] = <
					text = <"Nonsense CVC">
					description = <"Nonsense word comprising a consonant, then a vowel, then a final consonant, for example, \"wub\" or \"yat\".">
				>
				["at0073"] = <
					text = <"Nonsense word">
					description = <"A speech stimulus that is not a real word but is phonotactically correct.">
				>
				["at0074"] = <
					text = <"Monosyllabic word">
					description = <"A word comprised of a single syllable. For example, 'green'.">
				>
				["at0075"] = <
					text = <"Spondee word">
					description = <"A word comprised of two syllables with equal stress on each syllable. For example, 'sunshine'.">
				>
				["at0076"] = <
					text = <"Trochee word">
					description = <"A word that is comprised of two syllables with stress on the first syllable. For example, 'bucket'.">
				>
				["at0086"] = <
					text = <"Concrete object pointing">
					description = <"The response is given by pointing to a 3-dimensional object.">
				>
				["at0090"] = <
					text = <"Step size at start">
					description = <"The initial stepsize of level changes.">
					comment = <"May vary through measurement, depending on level control. ">
				>
				["at0093"] = <
					text = <"Presented sensory modalities">
					description = <"The method used to present the speech test stimulus.">
					comment = <"For example: a visual stimulus can be used to test lip reading skills.">
				>
				["at0094"] = <
					text = <"Auditory test">
					description = <"An auditory stimulus is presented to the test subject.">
				>
				["at0095"] = <
					text = <"Audiovisual test">
					description = <"A combination of auditory and visual stimuli are presented to the test subject.">
				>
				["at0096"] = <
					text = <"Visual test">
					description = <"A visual stimulus is presented to the test subject.">
				>
				["at0099"] = <
					text = <"Number">
					description = <"A number.">
				>
				["at0100"] = <
					text = <"Digit triplet">
					description = <"A sequence of three digits.">
				>
				["at0101"] = <
					text = <"Announcement">
					description = <"The type of announcement before presenting the speech stimulus.">
				>
				["at0102"] = <
					text = <"Sentence">
					description = <"An announcement sentence is presented prior to each stimulus.">
				>
				["at0103"] = <
					text = <"Non-speech auditory cue">
					description = <"A non-speech auditory announcement is presented prior to each stimulus (e.g., beep).">
				>
				["at0104"] = <
					text = <"Visual cue">
					description = <"A visual cue is presented prior to each stimulus (e.g., flashing light).">
				>
				["at0105"] = <
					text = <"Without">
					description = <"No announcement prior to each stimulus.">
				>
				["at0107"] = <
					text = <"Adaptive procedure">
					description = <"Details on the adaptive level control and fit procedure.">
					comment = <"Applicable for adaptive measurements.">
				>
				["at0113"] = <
					text = <"Scoring method">
					description = <"The scoring method used.">
				>
				["at0114"] = <
					text = <"Word scoring">
					description = <"Counting correct words in responses.">
				>
				["at0115"] = <
					text = <"Sentence scoring">
					description = <"Counting correct sentences in responses.">
				>
				["at0116"] = <
					text = <"Phoneme scoring">
					description = <"Counting correct phonemes in responses.">
				>
				["at0117"] = <
					text = <"Keyword scoring">
					description = <"Counting correct keywords in responses.">
				>
				["at0132"] = <
					text = <"Tested side">
					description = <"Identification of the tested ear(s).">
				>
				["at0133"] = <
					text = <"Left ear">
					description = <"The test stimuli were presented to the left ear.">
				>
				["at0134"] = <
					text = <"Right ear">
					description = <"The test stimuli were presented to the right ear.">
				>
				["at0135"] = <
					text = <"Binaural">
					description = <"The test stimuli were presented to both ears simultaneously.">
				>
				["at0137"] = <
					text = <"Matrix sentence">
					description = <"Sentence composed of a fixed syntactical structure without meaningful context.">
				>
				["at0138"] = <
					text = <"Meaningful sentence">
					description = <"A grammatical unit of one or more words that expresses an independent statement, question, request, command, exclamation, everyday-sentences etc.">
				>
				["at0140"] = <
					text = <"Stimulus details">
					description = <"Details on signals used as noise in 'Type of noise stimulus', e.g., name of established noise, number of talkers included in a babble noise, or other specific characteristics.">
					comment = <"Not applicable for speech in quiet tests.">
				>
				["at0145"] = <
					text = <"Test name">
					description = <"The name of the conducted speech test.">
					comment = <"Use published name (including a reference) if possible.">
				>
				["at0153"] = <
					text = <"Language proficiency">
					description = <"Language proficiency of the listener in broad categories.">
				>
				["at0154"] = <
					text = <"Native">
					description = <"Listener is native speaker in the presented test language.">
				>
				["at0155"] = <
					text = <"Fluent">
					description = <"Listener is fluent in the presented test language.">
				>
				["at0156"] = <
					text = <"Basic">
					description = <"Listener has only basic proficiency in the presented test language.">
				>
				["at0157"] = <
					text = <"None">
					description = <"Listener has no proficiency in the presented test language.">
				>
				["at0163"] = <
					text = <"No test result">
					description = <"Details to explicitly record that this examination was not performed.">
				>
				["at0164"] = <
					text = <"Hearing device during test">
					description = <"Indicates if hearing device(s) were used during the speech intelligibility test. ">
					comment = <"Note: This cluster is supposed to be used per device, and it needs to be repeated per device. Absence of the cluster indicates unaided measurements. ">
				>
				["at0165"] = <
					text = <"Hearing device">
					description = <"Details of the hearing device used.">
					comment = <"For example: hearing aid or cochlear implant as type of device.">
				>
				["at0166"] = <
					text = <"Side of hearing device">
					description = <"Identification of the side where the hearing device is worn during the test.">
				>
				["at0167"] = <
					text = <"Left">
					description = <"The hearing device is worn at the left side.">
				>
				["at0168"] = <
					text = <"Right">
					description = <"The hearing device is worn at the right side.">
				>
				["at0169"] = <
					text = <"Comment">
					description = <"Additional information about the hearing device that is not captured in 'Hearing device' or 'Side of hearing device'.">
					comment = <"For example: information about hearing device settings.">
				>
				["at0170"] = <
					text = <"Confounding factors">
					description = <"Additional issues or factors that may impact the speech test, not captured in other fields.">
					comment = <"For example: 
- Medication
- Noise exposure prior to test
- Working memory
- Dementia
- Speech production pathologies for open speech tests">
				>
				["at0171"] = <
					text = <"Computer">
					description = <"The response is entered via a software interface by the listener.">
				>
				["at0172"] = <
					text = <"Presentation method">
					description = <"The method used to present the test stimuli.">
				>
				["at0173"] = <
					text = <"Loudspeaker">
					description = <"The stimulus is presented via a loudspeaker.">
				>
				["at0174"] = <
					text = <"Insert earphone">
					description = <"The stimulus is presented via insert earphones.">
				>
				["at0175"] = <
					text = <"Headphone">
					description = <"The stimulus is presented via external headphones - either circumaural or supraaural.">
				>
				["at0176"] = <
					text = <"Direct streaming to sound processor">
					description = <"The stimulus is directly streamed to the sound processor of a hearing device.">
				>
				["at0177"] = <
					text = <"Live voice">
					description = <"The stimulus is spoken.">
				>
				["at0178"] = <
					text = <"Presentation method details">
					description = <"Details of device used to present the test stimulus as specified in 'Presentation method'.">
					comment = <"For example: type of headphone or speaker.">
				>
				["at0179"] = <
					text = <"Phoneme">
					description = <"A phoneme.">
				>
				["at0181"] = <
					text = <"Test environment">
					description = <"The environment in which the speech test is administered.">
				>
				["at0182"] = <
					text = <"Sound treated room">
					description = <"Test environment that has been treated acoustically.">
				>
				["at0183"] = <
					text = <"Non-sound treated room">
					description = <"Test environment that has not been treated acoustically.">
				>
				["at0184"] = <
					text = <"Freefield">
					description = <"Room with freefield characteristics.">
				>
				["at0185"] = <
					text = <"Test environment details">
					description = <"Additional details of 'Test environment'.">
					comment = <"For example: specific audiometric booth or a free text description of the room's sound treatment.">
				>
				["at0194"] = <
					text = <"Target speech intelligibility">
					description = <"The target percentage of the speech intelligibility measurement.">
					comment = <"For example: 50%.">
				>
				["at0196"] = <
					text = <"Fixed stimulus">
					description = <"To indicate which stimulus level (speech, noise or overall) is kept constant during the measurement.">
					comment = <"Only applicable for speech in noise tests measured adaptively.">
				>
				["at0197"] = <
					text = <"dB ref">
					description = <"Freefield-equivalent sound pressure level. Note that this level contains test- and transducer-specific level offsets to make results independent from used hardware. For freefield measurements, this is equivalent to dB SPL.">
				>
				["at0198"] = <
					text = <"dB SPL">
					description = <"Sound pressure level.">
				>
				["at0200"] = <
					text = <"Training condition">
					description = <"Indicates if the measurement was performed for training or test purposes.">
					comment = <"Applicable if the speech intelligibility test requires training, for example: Matrix test. ">
				>
				["at0201"] = <
					text = <"SRT calculation method">
					description = <"The description of how the SRT is derived from 'Measurements of test lists'. ">
				>
				["at0203"] = <
					text = <"Related measurements">
					description = <"The identifiers 'Measurements of test lists' from which the SRT is derived, as specified in 'Measurement identifier'. ">
				>
				["at0204"] = <
					text = <"Synthetic female">
					description = <"Stimuli presented by a synthetically generated female voice.">
				>
				["at0205"] = <
					text = <"Synthetic male">
					description = <"Stimuli presented by a synthetically generated male voice.">
				>
				["at0208"] = <
					text = <"Child">
					description = <"Stimuli presented by a child.">
				>
				["at0209"] = <
					text = <"Synthetic child">
					description = <"Stimuli presented by a synthetically generated children voice.">
				>
				["at0216"] = <
					text = <"Noise stimulus">
					description = <"Properties of the noise or interfering stimulus. ">
					comment = <"Can be repeated for several, directional noise stimuli, for example: competing talkers from different azimuth directions. ">
				>
				["at0217"] = <
					text = <"Azimuth">
					description = <"Azimuth angle of 'Noise stimulus'. 
">
				>
				["at0218"] = <
					text = <"Elevation">
					description = <"Elevation angle of 'Noise stimulus'.">
