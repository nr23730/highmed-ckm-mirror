				["at0288"] = <
					text = <"Fit procedure">
					description = <"The name of the fit procedure to estimate a speech recognition threshold. ">
					comment = <"Note: this is applicable if the fit procedure is directly linked to the level control, for example: in Brand and Kollmeier (2002). Otherwise, different fits retrospectively performed on measured data can be documented in 'Derived results' > 'Speech recognition threshold' > 'SRT calculation method'.  ">
				>
