definition
	CLUSTER[at0000] matches {    -- ACRIBIS Anamnese-Patient questionnaire
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- Do you have diabetes (diabetes mellitus) ?
				value matches {
					1|[local::at0016],
					2|[local::at0017],
					3|[local::at0018]
				}
			}
			ELEMENT[at0008] occurrences matches {0..1} matches {    -- Have you been diagnosed with heart failure (cardiac insufficiency)?
				value matches {
					1|[local::at0009],
					2|[local::at0010],
					3|[local::at0011]
				}
			}
			ELEMENT[at0012] occurrences matches {0..1} matches {    -- When was your heart failure medically diagnosed?
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
			ELEMENT[at0007] occurrences matches {0..1} matches {    -- In the last 12 months, was there an inpatient hospital treatment due to worsening of heart failure?
				value matches {
					1|[local::at0013],
					2|[local::at0014],
					3|[local::at0015]
				}
			}
		}
	}

