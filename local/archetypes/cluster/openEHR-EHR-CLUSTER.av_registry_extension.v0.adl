definition
	CLUSTER[at0000] matches {    -- AV registry extension
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Erkrankte Gefäße
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Frühere PCI Langzeittherapie
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Frühere PCI Kurzzeittherapie
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Datum der letzten Krankenhauseinweisung aufgrund von Herzinsuffizienz
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- Anzahl der Herzinsuffizienz-Hospitalisierungen im Vorjahr
				value matches {
					DV_COUNT matches {*}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- Anzahl der vorhandenen RV-Elektroden
				value matches {
					DV_COUNT matches {*}
				}
			}
			ELEMENT[at0007] occurrences matches {0..1} matches {    -- Frühere Endokarditis einer behandelten Klappe
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}


